# Habit Tracker Environment Example
PORT=5000
NODE_ENV=development
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@app-habittracker-projec.k8zwqpe.mongodb.net/habit_tracker_db?retryWrites=true&w=majority
USE_MEMORY_DB=false
CORS_ORIGIN=*
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000

# Mobile API Endpoint (Supports adb reverse tcp:5000 tcp:5000, local LAN, or emulator)
API_BASE_URL=http://127.0.0.1:5000/api
